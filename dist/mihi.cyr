# mihi.cyr -- bundled distribution
# Version: 1.2.4
# Generated by: cyrius distlib
# Do not edit -- rebuild with: cyrius distlib

# --- types.cyr ---

# mihi/types — shared types for the probe surface.
#
# Scaffold stage: empty. The MihiInfo struct + field constants land
# here once the first real probe drives the shape.

# --- io.cyr ---

# mihi/io — the single file-read path every /proc and /sys probe uses.
#
# Before 1.2.3 each probe hand-rolled `open / one read / close`, five
# times over, and each copy carried the same three defects:
#
#   1. **Silent truncation.** A single `sys_read(fd, buf, cap)` that
#      fills the buffer is indistinguishable from one that reached EOF.
#      Truncating `MemTotal:  61192260 kB` mid-digits does not fail —
#      it returns a *plausible smaller number*. A wrong fact is worse
#      than an error for a library whose whole job is reporting facts,
#      and CLAUDE.md's "one source per fact … if it's not present,
#      return error" says so directly.
#   2. **Short reads treated as EOF.** `read(2)` is permitted to return
#      fewer bytes than requested. seq_file-backed /proc and kernfs
#      -backed /sys files do not do this in practice for a large-enough
#      count, but the parsers were relying on an unwritten guarantee
#      rather than on looping.
#   3. **`-EINTR` treated as a hard failure.** A signal arriving during
#      the read made the probe report "no such fact". For `iam` on the
#      login path that is a spurious blank field.
#
# This module fixes all three once. It also adds two open flags the
# hand-rolled copies lacked:
#
#   - **`O_NONBLOCK`** — `/etc/os-release` is, per os-release(5), a
#     symlink (`/etc/os-release` → `/usr/lib/os-release`). A symlink is
#     a thing someone can repoint. If it ever resolves to a FIFO, a
#     blocking `open(2)` hangs the calling process — and mihi's first
#     consumer runs on the *login* path, so a hang there is a login
#     denial. With `O_NONBLOCK` the open returns immediately and the
#     subsequent read fails `-EAGAIN`, which becomes an honest probe
#     error. On regular, procfs, and sysfs files the flag is inert.
#     `O_NOFOLLOW` would be the blunter answer and is wrong here: it
#     would reject the legitimate symlink the spec mandates.
#   - **`O_CLOEXEC`** — the descriptor is closed a few instructions
#     later, so the window is tiny, but a consumer that forks from
#     another thread mid-probe would otherwise leak it into the child.
#     Free hygiene.
#
# Not used on AGNOS. Every probe takes a sysinfo(2) / CPUID / constant
# path on the sovereign target (there is no procfs to read), so the body
# is `#ifndef CYRIUS_TARGET_AGNOS` and the AGNOS arm returns a plain
# error. That is load-bearing rather than tidy: `O_CLOEXEC` and
# `O_NONBLOCK` are *not defined* on the AGNOS target (lib/io.cyr's
# agnos-only O_* set stops at `O_EXCL`), so the flags have to be removed
# by the preprocessor, not merely left unreached.

# Read modes, and return codes as negative magnitudes (the "no negative
# literals" convention — the function returns `0 - MIHI_IO_FAIL`).
#
#   MIHI_IO_WHOLE   the caller needs the entire file; a file larger
#                   than `cap` is an error, because every parser that
#                   asks for WHOLE extracts a value that a cut could
#                   silently shorten.
#   MIHI_IO_PREFIX  the caller only needs the head of the file and its
#                   parser is truncation-safe. Exactly one probe:
#                   mihi_cpu_model, which wants CPU 0's block out of a
#                   /proc/cpuinfo that is 26 kB on a 16-thread box and
#                   grows with core count — so "the whole file fits" was
#                   never the contract there, and its parser returns
#                   null rather than a partial value when the buffer
#                   ends mid-line. Do not reach for PREFIX to paper over
#                   an undersized buffer.
#
#   MIHI_IO_FAIL    open failed, read failed, or the file was empty.
#   MIHI_IO_TRUNC   WHOLE was asked for and the file did not fit in
#                   `cap`. Distinct from FAIL because it is the caller's
#                   buffer that is wrong, not the system; probes map
#                   both onto their own documented sentinel, but the
#                   tests assert the split.
enum MihiIoMode {
    MIHI_IO_WHOLE = 0;
    MIHI_IO_PREFIX = 1;
}
enum MihiIoStatus {
    MIHI_IO_FAIL = 1;
    MIHI_IO_TRUNC = 2;
    MIHI_IO_EINTR_MAX = 8;
}

# Read a small pseudo-file into `buf` (capacity `cap`).
#
# Returns the byte count on success (always >= 1), `0 - MIHI_IO_FAIL`
# if the file could not be opened or read or was empty, and
# `0 - MIHI_IO_TRUNC` if `mode` is MIHI_IO_WHOLE and the file did not
# fit in `cap`.
#
# Truncation is detected rather than assumed: when the read loop fills
# the buffer exactly, one more single-byte read decides whether that was
# EOF or a longer file. That costs one extra syscall only in the case
# that would otherwise return a wrong answer, and it is skipped
# entirely under MIHI_IO_PREFIX.
#
# `-EINTR` is retried up to MIHI_IO_EINTR_MAX times, then reported as a
# failure — bounded, so a pathological signal storm cannot spin here.
# Every other negative return fails immediately, `-EAGAIN` included:
# that is the O_NONBLOCK FIFO case above, and "would block" on a file
# that is supposed to be a 400-byte text file is not a retry, it is a
# wrong file.
#
# Still a pure read: open/read/close of a compile-time-constant path,
# no mutation of anything on the system, no process spawned.
fn _mihi_read_probe_file(path, buf, cap, mode): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - MIHI_IO_FAIL;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (cap <= 0) { return 0 - MIHI_IO_FAIL; }
    var fd = sys_open(path, O_RDONLY | O_CLOEXEC | O_NONBLOCK, 0);
    if (fd < 0) { return 0 - MIHI_IO_FAIL; }
    var total = 0;
    var eintr = 0;
    var failed = 0;
    var done = 0;
    var n = 0;
    var probe[8];
    var extra = 0;
    while (done == 0) {
        n = sys_read(fd, buf + total, cap - total);
        if (n < 0) {
            if (n == 0 - EINTR && eintr < MIHI_IO_EINTR_MAX) {
                eintr = eintr + 1;
            } else {
                failed = 1;
                done = 1;
            }
            continue;
        }
        if (n == 0) {
            done = 1;
            continue;
        }
        total = total + n;
        if (total >= cap) { done = 1; }
    }
    if (failed == 1) {
        sys_close(fd);
        return 0 - MIHI_IO_FAIL;
    }
    # Buffer full — was that EOF, or is there more file behind it?
    if (total >= cap && mode == MIHI_IO_WHOLE) {
        extra = sys_read(fd, &probe, 1);
    }
    sys_close(fd);
    if (extra > 0) { return 0 - MIHI_IO_TRUNC; }
    if (total <= 0) { return 0 - MIHI_IO_FAIL; }
    return total;
    #endif
}

# --- cpu.cyr ---

# mihi/cpu — CPU probes.
#
# Slice A: mihi_cpu_arch via uname.machine (shares uts buffer with
# kernel.cyr per ADR 0001).
#
# Slice B: mihi_cpu_count via /sys/devices/system/cpu/online,
# mihi_cpu_model via /proc/cpuinfo first block. Both follow the
# read-into-caller-buffer convention; cpu_count's return is an
# integer so it uses a stack-local scratch buffer.

# `cyrius build --agnos` does NOT predefine CYRIUS_ARCH_X86 (only a native x86 build
# does), so the CPUID brand asm below (guarded #ifdef CYRIUS_ARCH_X86) was compiled
# OUT on agnos → CPU rendered "(unknown)" while iam ran fine. agnos IS x86, so map it:
# (a future aarch64-agnos would set CYRIUS_ARCH_AARCH64 and skip this.)
#ifdef CYRIUS_TARGET_AGNOS
#define CYRIUS_ARCH_X86
#endif

# ----- Slice A — uname.machine -------------------------------------

# Return a pointer to the null-terminated machine field within `uts`.
# Caller must have already filled `uts` via mihi_uname.
# Source: utsname.machine (offset 260, see sys.cyr UTS_MACHINE) —
# kernel arch identifier ("x86_64", "aarch64", etc.). On AGNOS-native
# this will eventually come from the boot-info struct instead.
# Returns cstring so println() dispatches to the string overload.
fn mihi_cpu_arch(uts): cstring {
    return uts + UTS_MACHINE;
}

# ----- Slice B — /sys/devices/system/cpu/online --------------------

# MIHI_CPU_MAX — sanity ceiling on a parsed logical-CPU count. Linux's
# CONFIG_NR_CPUS tops out at 8192 (x86_64 MAXSMP) / 16384 (arm64); 2^20
# is two orders of magnitude clear of both, so nothing real trips it and
# only corrupt input does. See mihi_parse_cpu_range.
#
# MIHI_CPU_ONLINE_CAP — read capacity for /sys/devices/system/cpu/online,
# mirrored by the `var online[1024]` declaration in mihi_cpu_count (array
# sizes take literals). The file is "0-15" on a normal box, but the
# kernel emits a %*pbl range list, so a machine with many offline CPUs
# produces a long comma-separated list. 64 bytes (the pre-1.2.3 size)
# truncated such a list mid-range and returned a plausible wrong count.
enum MihiCpuLimit {
    MIHI_CPU_MAX = 1048576;
    MIHI_CPU_ONLINE_CAP = 1024;
}

# Parse a CPU range string like "0-15" or "0-3,5-7" or "0" into a
# logical-CPU count. Sums (hi-lo+1) per comma-separated range; bare
# "N" is treated as N-N. Whitespace, newlines, and commas are
# separators. Returns 0 if no digits found.
# Source: Documentation/admin-guide/cputopology.rst, %*pbl format.
# Pure-function — testable with synthetic buffers, no syscall.
#
# Defensive (2026-05-19 audit C-1, C-2):
#   - Caps each digit accumulator at 18 digits (~10^18, well under
#     i64 max). Prevents overflow on adversarial /sys content; the
#     real kernel never emits more than ~5 digits per range bound.
#   - Coerces descending ranges (hi < lo, e.g. "10-5") to single-CPU
#     ranges. Real kernel output is always ascending; this defends
#     against a corrupted /sys file producing a negative addend.
#
# Defensive (2026-08-23 audit A-2): the per-range digit cap bounds each
# *addend* to < 10^18, but `total` accumulated without any bound — ten
# such ranges overflow i64 and the count comes back negative. The 64-byte
# read buffer used to make that unreachable by arithmetic; A-1 grew the
# buffer to 1024, so it stopped being unreachable. Any total above
# MIHI_CPU_MAX (2^20 — two orders of magnitude past Linux's 8192-CPU
# CONFIG_NR_CPUS ceiling) means corrupt input, and the function reports
# malformed input the way it already does elsewhere: return 0.
fn mihi_parse_cpu_range(buf, len): i64 {
    var total = 0;
    var i = 0;
    var done = 0;
    while (done == 0) {
        # skip separators (' ', '\n', ',')
        while (i < len && (load8(buf + i) == 32 || load8(buf + i) == 10 || load8(buf + i) == 44)) {
            i = i + 1;
        }
        if (i >= len) {
            done = 1;
            continue;
        }
        var c0 = load8(buf + i);
        if (c0 < 48 || c0 > 57) {
            # non-digit, non-separator — malformed; stop counting.
            done = 1;
            continue;
        }
        # parse lo (cap 18 digits — audit C-2 / overflow defense)
        var lo = 0;
        var ld = 0;
        while (i < len && load8(buf + i) >= 48 && load8(buf + i) <= 57 && ld < 18) {
            lo = lo * 10 + (load8(buf + i) - 48);
            ld = ld + 1;
            i = i + 1;
        }
        # optional -hi
        var hi = lo;
        if (i < len && load8(buf + i) == 45) {
            i = i + 1;
            hi = 0;
            var hd = 0;
            while (i < len && load8(buf + i) >= 48 && load8(buf + i) <= 57 && hd < 18) {
                hi = hi * 10 + (load8(buf + i) - 48);
                hd = hd + 1;
                i = i + 1;
            }
        }
        # Coerce descending ranges (audit C-1).
        if (hi < lo) { hi = lo; }
        total = total + (hi - lo + 1);
        # Overflow guard (audit A-2). Checked every iteration, so `total`
        # can never climb far enough to wrap: each addend is < 10^18 and
        # the guard trips at 2^20, so the largest value `total` can hold
        # is ~10^18 — three orders of magnitude below i64 max.
        if (total > MIHI_CPU_MAX) {
            total = 0;
            done = 1;
        }
    }
    return total;
}

# Count logical CPUs from /sys/devices/system/cpu/online.
# Returns logical CPU count, or 0 - 1 on open/read/truncation error.
# Source: kernel/cpu.c::cpu_online_mask exported via sysfs, formatted
# with %*pbl (Documentation/admin-guide/cputopology.rst).
fn mihi_cpu_count(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # AGNOS has no /sys — read the enumerated CPU count from sysinfo#35 (§4.4 `cpus`
    # @ SI_CPUS=32; was a stale hardcoded 1). The buffer is sized 120 to match every
    # other sysinfo call site in mihi rather than the 40 bytes AGNOS §4.4 currently
    # needs: sys_sysinfo passes its own length to the kernel, so the extra bytes cost
    # one stack frame and remove a size that would have to be revisited if §4.4 grows.
    var info[120];
    var rc = sys_sysinfo(&info);
    if (rc != 0) { return 0 - 1; }
    var n = load64(&info + SI_CPUS);
    if (n < 1) { return 1; }
    return n;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var online[1024];   # MIHI_CPU_ONLINE_CAP
    var n = _mihi_read_probe_file("/sys/devices/system/cpu/online", &online, MIHI_CPU_ONLINE_CAP, MIHI_IO_WHOLE);
    if (n < 0) { return 0 - 1; }
    return mihi_parse_cpu_range(&online, n);
    #endif
}

# ----- Slice B — /proc/cpuinfo model name ---------------------------

# Scan `buf` (length `len`, freshly read from /proc/cpuinfo) for the
# first "model name" line, null-terminate the value in place by
# overwriting its trailing newline, and return a cstring pointer to
# the value's first character. Returns 0 (null) if not found.
#
# /proc/cpuinfo on Linux always begins with "processor\t: 0\n", so
# "model name" is preceded by '\n' — we search for "\nmodel name"
# rather than worrying about file-start. This naturally pins us to
# CPU 0's block, satisfying "one source per fact" on heterogeneous
# big.LITTLE parts.
#
# Mutates `buf` (writes a single NUL byte). Pure parser otherwise —
# unit-testable against a synthetic cpuinfo buffer.
fn mihi_parse_cpu_model(buf, len): cstring {
    var target = "\nmodel name";
    var tlen = 11;
    var i = 0;
    var found = 0 - 1;
    while (i + tlen <= len && found == 0 - 1) {
        # "matched" not "match" — match is a reserved keyword in cyrius.
        var matched = 1;
        var j = 0;
        while (j < tlen && matched == 1) {
            if (load8(buf + i + j) != load8(target + j)) { matched = 0; }
            j = j + 1;
        }
        if (matched == 1) { found = i + 1; }  # +1 skips the leading '\n'
        i = i + 1;
    }
    if (found == 0 - 1) { return 0; }
    # Skip past "model name" (10 bytes), then any \t/space/':' before the value.
    var p = found + 10;
    while (p < len && (load8(buf + p) == 9 || load8(buf + p) == 32 || load8(buf + p) == 58)) {
        p = p + 1;
    }
    if (p >= len) { return 0; }
    var start = p;
    while (p < len && load8(buf + p) != 10) { p = p + 1; }
    if (p >= len) { return 0; }
    store8(buf + p, 0);
    return buf + start;
}

# ----- Slice B (aarch64 Linux) — device-tree CPU compatible ---------
#
# arm64 Linux publishes no `model name` line (audit D-1 / roadmap): the
# kernel's c_show() prints CPU implementer / part / revision as raw
# hex and nothing human-readable. Verified on iron, agnosarm (Raspberry
# Pi 4 Model B, kernel 6.8.0-1053-raspi):
#     $ grep -c "model name" /proc/cpuinfo
#     0
# The device tree does carry it, per CPU, in the property the ORIGINAL
# (wrong) citation named before D-1 corrected it:
#     /sys/firmware/devicetree/base/cpus/cpu@0/compatible
#     = "arm,cortex-a72\0"
# So this is not a fallback for the x86 path — it is a separate,
# arch-native source, the same shape as the AGNOS→CPUID split. cpu@0
# anchors the fact the way "\nmodel name" anchors it on x86: one
# source per fact, and the first core on a big.LITTLE part.
#
# ⚠ Device-tree only. An arm64 machine booted via ACPI (most server
# hardware) has no /sys/firmware/devicetree, so this returns 0 and the
# consumer renders "unknown" — the same honest null D-1 documented,
# now narrowed from "all of aarch64" to "ACPI-booted aarch64".

# Parse a device-tree string property. Unlike the /proc text files, a
# DT property blob IS the value and carries its own NUL — the file is
# 15 bytes for "arm,cortex-a72\0", with no trailing newline. A
# `compatible` property may hold a LIST of NUL-separated strings, most
# specific first (the root node's is "raspberrypi,4-model-b\0brcm,
# bcm2711\0"), so returning the first entry is the DT convention, not
# a shortcut.
#
# Returns a cstring into `buf`, or 0 if the blob is empty or carries no
# terminator. Does NOT mutate `buf` — the terminator is already there,
# and a blob without one is malformed input rather than something to
# repair in place ("one source per fact ... return error").
# Pure function — unit-testable against a synthetic blob.
fn mihi_parse_dt_string(buf, len): cstring {
    if (len <= 0) { return 0; }
    var i = 0;
    var term = 0 - 1;
    while (i < len && term == 0 - 1) {
        if (load8(buf + i) == 0) { term = i; }
        i = i + 1;
    }
    if (term == 0 - 1) { return 0; }   # no NUL in the blob — malformed
    if (term == 0) { return 0; }       # empty string property
    return buf;
}

# ----- Slice B (agnos / sovereign) — CPUID processor brand string ---
#
# /proc/cpuinfo is Linux-only; AGNOS has no procfs, so the model line rendered
# "(unknown)" there. The brand string is the SAME datum Linux's "model name"
# derives from: CPUID leaves 0x80000002/3/4 return 48 bytes (EAX/EBX/ECX/EDX
# each) — the human "AMD Ryzen … " / "Intel(R) Core … " string. This path works
# bare-metal on any x86 target (agnos AND Linux), so it is validated on the Linux
# host against /proc/cpuinfo before it ever ships to agnos.

# Fill buf[0..47] with the raw 48-byte CPUID brand string. x86 only.
# Returns 1 on x86, 0 otherwise.
#
# ⚠ `buf` MUST be >= 48 bytes, and this function CANNOT CHECK THAT — it
# takes no capacity parameter and stores 48 bytes unconditionally. The
# only in-tree caller, mihi_cpu_model_cpuid, rejects `cap < 49` before
# reaching here. Audit finding A-7 (2026-08-23): the name carries no
# leading underscore, so this is on the bundle's public surface and a
# consumer could call it directly with a short buffer. Adding a `cap`
# parameter is a signature change and the API has been frozen since
# 1.0.0, so it is a v2.0 item; until then this comment is the contract.
# The 48 bytes come from the `cpuid` instruction, not from any file, so
# nothing attacker-controlled reaches the store.
#
# `param_load(rdi, 0)` loads param 0 (`buf`) into rdi with the slot offset resolved
# at EMIT TIME (cyrius 6.0.67+) — prologue-drift-proof, the sigil `_sha_ni_cpuid_probe`
# idiom. (v1.2.0 instead HAND-ASSUMED `buf` stayed in rdi from the SysV entry: that
# held on the Linux build but the agnos codegen's prologue clobbered rdi → `[rdi+N]`
# wrote to garbage → iam faulted, `run: exit 142`, caught in QEMU by iam-agnos-verify —
# NOT on iron.) cpuid clobbers rax/rbx/rcx/rdx (rbx push/pop'd per leaf) but not rdi,
# so `buf` persists across all 3 leaves after the single param_load.
fn mihi_cpu_brand_fill(buf): i64 {
    #ifdef CYRIUS_ARCH_X86
    asm {
        param_load(rdi, 0);            # buf (param 0) — prologue-drift-proof
        0xB8; 0x02; 0x00; 0x00; 0x80;  # mov eax, 0x80000002
        0x53;                          # push rbx
        0x0F; 0xA2;                    # cpuid
        0x89; 0x07;                    # mov [rdi],    eax
        0x89; 0x5F; 0x04;              # mov [rdi+4],  ebx
        0x89; 0x4F; 0x08;              # mov [rdi+8],  ecx
        0x89; 0x57; 0x0C;              # mov [rdi+12], edx
        0x5B;                          # pop rbx
        0xB8; 0x03; 0x00; 0x00; 0x80;  # mov eax, 0x80000003
        0x53;                          # push rbx
        0x0F; 0xA2;                    # cpuid
        0x89; 0x47; 0x10;              # mov [rdi+16], eax
        0x89; 0x5F; 0x14;              # mov [rdi+20], ebx
        0x89; 0x4F; 0x18;              # mov [rdi+24], ecx
        0x89; 0x57; 0x1C;              # mov [rdi+28], edx
        0x5B;                          # pop rbx
        0xB8; 0x04; 0x00; 0x00; 0x80;  # mov eax, 0x80000004
        0x53;                          # push rbx
        0x0F; 0xA2;                    # cpuid
        0x89; 0x47; 0x20;              # mov [rdi+32], eax
        0x89; 0x5F; 0x24;              # mov [rdi+36], ebx
        0x89; 0x4F; 0x28;              # mov [rdi+40], ecx
        0x89; 0x57; 0x2C;              # mov [rdi+44], edx
        0x5B;                          # pop rbx
    }
    return 1;
    #endif
    #ifndef CYRIUS_ARCH_X86
    return 0;
    #endif
}

# CPUID brand → trimmed, NUL-terminated cstring in `buf`. `cap` must be >= 49
# (48 brand bytes + NUL). Strips trailing padding (AMD NUL-pads, Intel space-pads)
# and skips Intel's leading-space left-pad. Returns a cstring into `buf`, or 0 on
# non-x86 / too-small buf / all-blank brand.
fn mihi_cpu_model_cpuid(buf, cap): cstring {
    if (cap < 49) { return 0; }
    if (mihi_cpu_brand_fill(buf) == 0) { return 0; }   # non-x86
    store8(buf + 48, 0);
    # strip trailing spaces / NULs
    var end = 48;
    while (end > 0 && (load8(buf + end - 1) == 32 || load8(buf + end - 1) == 0)) {
        end = end - 1;
    }
    store8(buf + end, 0);
    # skip leading spaces (Intel left-pads the brand)
    var start = 0;
    while (start < end && load8(buf + start) == 32) {
        start = start + 1;
    }
    if (start >= end) { return 0; }   # all blank → treat as probe failure
    return buf + start;
}

# Read /proc/cpuinfo into the caller-supplied `buf` (capacity `cap`,
# recommend 8192). Returns cstring ptr into `buf` to the null-terminated
# model string, or 0 (null) on open/read/parse failure.
#
# 8192 is NOT "the file fits" and never was — /proc/cpuinfo is one block
# per logical CPU and measures 26 kB on a 16-thread box, growing with
# core count. It is "CPU 0's block fits", which is all this probe wants
# (see mihi_parse_cpu_model on why it anchors to the first block). So
# this is the one read in mihi that passes MIHI_IO_PREFIX: a short read
# is the expected case, not an error. That is safe only because the
# parser cannot return a partial value — if the buffer ends before the
# line's closing newline it returns 0, never half a brand string.
# Source: fs/proc/cpuinfo.c → arch-specific show_cpuinfo(), i.e.
# arch/x86/kernel/cpu/proc.c. The "model name" field is the human brand
# string from CPUID brand-string leaves 0x80000002/3/4.
#
# Three targets, three sources, no fallback chain between them:
#   AGNOS          → CPUID brand string (no procfs on the sovereign kernel)
#   aarch64 Linux  → device tree, cpus/cpu@0/compatible
#   x86 Linux      → /proc/cpuinfo "model name"
#
# The aarch64 arm exists because the kernel's c_show()
# (arch/arm64/kernel/cpuinfo.c) emits "processor", "BogoMIPS",
# "Features", "CPU implementer", "CPU architecture", "CPU variant",
# "CPU part", "CPU revision" — and NO "model name" line at all. The
# 2026-08-23 audit (finding D-1) caught the comment here claiming
# otherwise and left the gap open; 1.2.4 closes it against real arm64
# hardware. Note the two arms return different *flavours* of string —
# x86 gives a marketing brand ("AMD Ryzen 7 5800H with Radeon
# Graphics"), the device tree gives a compatible tuple
# ("arm,cortex-a72"). mihi returns each raw, vendor prefix included;
# prettifying is the consumer's job per CLAUDE.md.
fn mihi_cpu_model(buf, cap): cstring {
    #ifdef CYRIUS_TARGET_AGNOS
    # AGNOS has no /proc — read the brand straight from CPUID (the same x86 datum
    # /proc/cpuinfo's "model name" is printed from). Linux-validated (see tests).
    return mihi_cpu_model_cpuid(buf, cap);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    #ifdef CYRIUS_ARCH_AARCH64
    # arm64 Linux: the device tree, not /proc/cpuinfo — see the
    # mihi_parse_dt_string block above and audit finding D-1. WHOLE, not
    # PREFIX: the property is 15 bytes and a cut one has no terminator.
    var na = _mihi_read_probe_file("/sys/firmware/devicetree/base/cpus/cpu@0/compatible",
      buf, cap, MIHI_IO_WHOLE);
    if (na < 0) { return 0; }
    return mihi_parse_dt_string(buf, na);
    #endif
    #ifndef CYRIUS_ARCH_AARCH64
    var n = _mihi_read_probe_file("/proc/cpuinfo", buf, cap, MIHI_IO_PREFIX);
    if (n < 0) { return 0; }
    return mihi_parse_cpu_model(buf, n);
    #endif
    #endif
}

# --- mem.cyr ---

# mihi/mem — memory probes.
#
# Linux source of truth: /proc/meminfo. Kernel writes one line per
# fact, format: `Name:\t<padding>VALUE kB\n`. We read up to 4096 bytes
# (meminfo is usually ~1.5 kB) into a caller-supplied scratch buffer,
# line-anchor-search the field name, skip whitespace, parse the
# decimal kB count, multiply by 1024 → bytes.
#
# Why /proc/meminfo rather than sysinfo(2): sysinfo's `freeram` is the
# dumb "memory not currently allocated" number that misses reclaimable
# page cache. /proc/meminfo's `MemAvailable:` (kernel/3.14+) is the
# kernel's own estimate of what's actually allocatable without
# swapping — what every monitoring tool reports as "free." See
# kernel commit 34e431b0ae39.

# MIHI_MEM_KB_MAX — largest kB value that survives the * 1024 scaling
# without wrapping i64: floor(2^63 - 1 / 1024) = 2^53 - 1, which is
# ~9 EiB of RAM. Anything at or under this is scaled; anything over it
# is corrupt input and reported as an error rather than wrapped.
# See mihi_extract_meminfo_bytes and the 2026-08-23 audit, finding A-3.
enum MihiMemLimit {
    MIHI_MEM_KB_MAX = 9007199254740991;
}

# Find a line-anchored field in `buf`. `field` is the bare field
# name with trailing colon (e.g. "MemTotal:"). The match position
# must either be at offset 0 (file-start) or be preceded by '\n'.
# Returns the offset just past the field's colon (where the value
# whitespace begins), or 0 - 1 if not found.
# Pure function — exposed for unit tests against synthetic buffers.
fn mihi_find_meminfo_field(buf, len, field, field_len): i64 {
    var i = 0;
    var found = 0 - 1;
    while (i + field_len <= len && found == 0 - 1) {
        var anchored = 0;
        if (i == 0) { anchored = 1; }
        if (i > 0 && load8(buf + i - 1) == 10) { anchored = 1; }
        if (anchored == 1) {
            var matched = 1;
            var j = 0;
            while (j < field_len && matched == 1) {
                if (load8(buf + i + j) != load8(field + j)) { matched = 0; }
                j = j + 1;
            }
            if (matched == 1) { found = i + field_len; }
        }
        i = i + 1;
    }
    return found;
}

# Parse a meminfo value: skip whitespace (tab/space), accumulate
# decimal digits, return the kB integer or 0 - 1 if no digit appears.
# Caller has already located the start position past the field colon.
#
# Defensive (2026-05-19 audit M-1): caps digit accumulator at 18
# digits — i64 max is 19 digits, so 18 leaves headroom against the
# multiply-by-10 overflow. Real /proc/meminfo never emits more than
# ~10 digits per field (16 EiB is the practical ceiling).
fn mihi_parse_meminfo_kb(buf, len, start): i64 {
    var p = start;
    while (p < len && (load8(buf + p) == 9 || load8(buf + p) == 32)) {
        p = p + 1;
    }
    if (p >= len) { return 0 - 1; }
    var v = 0;
    var has = 0;
    var d = 0;
    while (p < len && load8(buf + p) >= 48 && load8(buf + p) <= 57 && d < 18) {
        v = v * 10 + (load8(buf + p) - 48);
        has = 1;
        d = d + 1;
        p = p + 1;
    }
    if (has == 0) { return 0 - 1; }
    return v;
}

# Convenience: find field, parse kB, return bytes (kB * 1024) or 0 - 1.
#
# The kB unit is a misnomer the kernel is stuck with for ABI reasons:
# proc_meminfo(5) states the values are really KiB (1024 B), not kB
# (1000 B), and that the label is not corrected because programs parse
# it. So the scale factor is 1024 and that is deliberate.
#
# Defensive (2026-08-23 audit A-3): the 0.6.0 M-1 fix capped the digit
# accumulator at 18 digits, which bounds `kb` below 10^18 — but 10^18
# * 1024 is ~1.02e21, four times i64 max. So the guard that made the
# *accumulator* safe left the *scale* able to wrap, and a wrapped
# result can come back NEGATIVE — straight past a consumer's
# `total >= 0` sanity check and into a rendered figure. Reject rather
# than saturate: a value that large is not a truncated fact, it is a
# corrupt one, and "one source per fact … return error" applies.
fn mihi_extract_meminfo_bytes(buf, len, field, field_len): i64 {
    var start = mihi_find_meminfo_field(buf, len, field, field_len);
    if (start < 0) { return 0 - 1; }
    var kb = mihi_parse_meminfo_kb(buf, len, start);
    if (kb < 0) { return 0 - 1; }
    if (kb > MIHI_MEM_KB_MAX) { return 0 - 1; }
    return kb * 1024;
}

# Read /proc/meminfo into the caller-supplied `buf` (capacity `cap`,
# recommend 4096 — meminfo is typically ~1.5 kB), parse MemTotal,
# return total RAM in bytes. Returns 0 - 1 on open/read/parse failure.
# Source: man 5 proc; kernel fs/proc/meminfo.c::meminfo_proc_show().
fn mihi_mem_total(buf, cap): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # AGNOS has no /proc/meminfo — total RAM comes from sysinfo#35 (via
    # sys_sysinfo; SI_TOTALRAM is reported in bytes directly).
    var si[120];
    if (sys_sysinfo(&si) != 0) { return 0 - 1; }
    return sysinfo_total_memory(&si);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var n = _mihi_read_probe_file("/proc/meminfo", buf, cap, MIHI_IO_WHOLE);
    if (n < 0) { return 0 - 1; }
    return mihi_extract_meminfo_bytes(buf, n, "MemTotal:", 9);
    #endif
}

# Read /proc/meminfo, parse MemAvailable, return available RAM in
# bytes. MemAvailable is the kernel's estimate of allocatable memory
# (accounts for reclaimable cache + slab); preferred over MemFree
# for "how much can I actually use" queries. Available since Linux
# 3.14 — on an older kernel the field is absent and this returns 0 - 1.
# Source: kernel commit 34e431b0ae39, fs/proc/meminfo.c.
fn mihi_mem_free(buf, cap): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # Was the one probe with no AGNOS arm at all: it fell through to a
    # Linux `open("/proc/meminfo")` that the sovereign kernel cannot
    # satisfy, so it always returned 0 - 1 there. The 1.1.2 note called
    # that "no sysinfo equivalent", which stopped being true when
    # lib/sys.cyr grew the AGNOS §4.4 layout — freeram sits at
    # SI_FREERAM (+16) and sysinfo_free_memory() reads it per-target.
    #
    # ⚠ Semantics differ from the Linux arm and that is not hidden:
    # Linux reports MemAvailable (free + reclaimable), AGNOS §4.4
    # reports plain free. It is the closest fact the sovereign kernel
    # publishes, and a real number beats a permanent error — but a
    # consumer comparing the two across targets is comparing two
    # different questions. Separate code path, not a fallback chain.
    var si[120];
    if (sys_sysinfo(&si) != 0) { return 0 - 1; }
    return sysinfo_free_memory(&si);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var n = _mihi_read_probe_file("/proc/meminfo", buf, cap, MIHI_IO_WHOLE);
    if (n < 0) { return 0 - 1; }
    return mihi_extract_meminfo_bytes(buf, n, "MemAvailable:", 13);
    #endif
}

# --- kernel.cyr ---

# mihi/kernel — kernel identity probes.
#
# Linux source of truth: uname(2) — see man 2 uname / asm-generic/utsname.h.
# The kernel writes a 390-byte struct utsname split into six 65-byte
# null-terminated fields. We need sysname (offset 0) and release
# (offset 130). lib/sys.cyr provides the raw uname syscall; we
# layer field-accessors named after the mihi probe surface on top.
#
# AGNOS-native: kernel name + version come from the boot-info struct
# at handoff, not from a faked utsname. That path lands when AGNOS has
# a stable boot-info ABI; today's bodies are Linux-only.
#
# Buffer contract (see docs/adr/0001-shared-uts-buffer.md):
#   Caller allocates uts[UTS_SIZE] on its stack, calls mihi_uname(uts)
#   once, then reads whichever fields it wants. mihi owns no state.

# Fill `uts` (must point to at least UTS_SIZE bytes — 390 on Linux,
# 64 on AGNOS) with the current kernel's utsname struct. Returns
# Result: Ok(uts) or Err.
# Source: uname(2) — Linux kernel arch/*/kernel/sys.c::sys_newuname.
#
# Hardened at the 2026-08-23 audit (finding A-4): the buffer is zeroed
# BEFORE the syscall. The four field accessors (mihi_kernel_name /
# mihi_kernel_version / mihi_cpu_arch / mihi_hostname) are pure pointer
# math and, by the ADR 0001 contract, do not verify that this call
# succeeded. A caller that ignores the Result and reads a field after a
# failed uname was therefore handed a pointer into UNINITIALISED STACK
# and a "cstring" with no terminator in it — so the consumer's
# println() walks off the buffer. That is the one place in mihi where a
# caller mistake turned into an out-of-bounds read rather than a wrong
# value. Zeroing first costs UTS_SIZE byte-stores once per process and
# converts the worst case from an OOB walk into an empty string, which
# is exactly what the "zero-init uts" test already asserts is safe.
# lib/sys.cyr's macOS arm zeroes for the same reason.
fn mihi_uname(uts): i64 {
    var z = 0;
    while (z < UTS_SIZE) {
        store8(uts + z, 0);
        z = z + 1;
    }
    # sys_uname (lib/sys.cyr) returns raw 0 / -errno; wrap as Result for callers
    # that check is_ok / is_err_result (iam). The UTS_* offsets resolve
    # target-correct from sys.cyr — AGNOS: sysname@0 / nodename@16 / release@32 /
    # machine@48 in the sovereign 64-byte struct; Linux: the 390-byte layout.
    var rc = sys_uname(uts);
    if (rc != 0) { return Err(rc); }
    return Ok(uts);
}

# Return a pointer to the null-terminated sysname field within `uts`.
# Caller must have already filled `uts` via mihi_uname.
# Source: utsname.sysname (offset 0, see sys.cyr UTS_SYSNAME) —
# kernel UTS namespace, written at boot. On Linux this is "Linux".
# Returns cstring so println() dispatches to the string overload.
fn mihi_kernel_name(uts): cstring {
    return uts + UTS_SYSNAME;
}

# Return a pointer to the null-terminated release field within `uts`.
# Source: utsname.release — `uname -r` output;
# arch/*/include/generated/utsrelease.h baked at kernel build time.
fn mihi_kernel_version(uts): cstring {
    return uts + UTS_RELEASE;
}

# --- host.cyr ---

# mihi/host — host identity probes.
#
# Three small probes that close the "tell me about this box" surface
# for the login MOTD path: hostname, system uptime, distro PRETTY_NAME.
#
# Sources of truth:
#   - hostname: uname(2).nodename — shares the uts buffer the kernel /
#     CPU-arch probes already populate (ADR 0001). One syscall covers
#     four facts.
#   - uptime:   /proc/uptime first whitespace-separated field, seconds
#     with fractional precision. Kernel writes ~64 bytes — caller's
#     scratch buffer of ~64 bytes is plenty.
#   - distro:   /etc/os-release PRETTY_NAME (shell-style key=value,
#     values optionally single- OR double-quoted per the spec). Falls
#     back to ID when PRETTY_NAME is absent — the only fallback in
#     mihi. Its justification was corrected at the 2026-08-23 audit
#     (finding D-2): os-release(5) marks PRETTY_NAME optional, and it
#     marks ID optional too ("If not set, a default of ID=linux may be
#     used") — so ID is NOT "the mandatory minimum every distro ships",
#     as this comment used to claim. The fallback stands on weaker but
#     still real ground: the two keys are the only ones that name the
#     OS, PRETTY_NAME is what a human wants, and ID is what is left. A
#     file carrying neither yields a null return, not a guess.
#     /etc/os-release is small (~1 kB in practice) so a 1 KiB scratch
#     buffer is sufficient.
#
# AGNOS-native: hostname will come from the boot-info struct alongside
# the other uname facts; uptime from a future native clock primitive;
# distro is a Linux-userland concept (the file lives in initramfs/root)
# and is not on the native code path.

# ----- mihi_hostname — uname.nodename --------------------------------

# Return a pointer to the null-terminated nodename field within `uts`.
# Caller must have already filled `uts` via mihi_uname.
# Source: utsname.nodename (offset 65, see sys.cyr UTS_NODENAME) —
# kernel UTS namespace, set by sethostname(2) at boot. On systems
# without a hostname configured the kernel reports "(none)".
# Returns cstring so println() dispatches to the string overload.
fn mihi_hostname(uts): cstring {
    return uts + UTS_NODENAME;
}

# ----- mihi_uptime_secs — /proc/uptime first field -------------------

# Parse the integer-seconds prefix of a /proc/uptime buffer: digits
# accumulate until any non-digit byte (typically '.' for the fractional
# part, ' ' between fields, or '\n'). Returns 0 - 1 if no leading
# digit. Pure parser — exposed for unit tests.
# Source: kernel fs/proc/uptime.c::uptime_proc_show — writes
# "%lu.%02lu %lu.%02lu\n" (uptime seconds + idle seconds).
#
# Defensive (2026-05-19 audit C-2): caps digit count at 18 to defend
# against integer overflow on adversarial /proc/uptime content. Real
# kernel uptime is bounded by clock resolution and process lifetime;
# 10 digits covers ~300 years.
fn mihi_parse_uptime_secs(buf, len): i64 {
    if (len <= 0) { return 0 - 1; }
    var p = 0;
    var v = 0;
    var has = 0;
    var d = 0;
    while (p < len && load8(buf + p) >= 48 && load8(buf + p) <= 57 && d < 18) {
        v = v * 10 + (load8(buf + p) - 48);
        has = 1;
        d = d + 1;
        p = p + 1;
    }
    if (has == 0) { return 0 - 1; }
    return v;
}

# Read /proc/uptime into the caller-supplied `buf` (capacity `cap`,
# recommend 64 — file is ~32 bytes), parse the first whitespace-
# separated field as decimal seconds, drop the fractional part.
# Returns 0 - 1 on open/read/parse failure.
# Source: man 5 proc; kernel fs/proc/uptime.c::uptime_proc_show().
fn mihi_uptime_secs(buf, cap): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # AGNOS has no /proc/uptime — uptime comes from sysinfo#35 (SI_UPTIME, secs).
    var si[120];
    if (sys_sysinfo(&si) != 0) { return 0 - 1; }
    return sysinfo_uptime(&si);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var n = _mihi_read_probe_file("/proc/uptime", buf, cap, MIHI_IO_WHOLE);
    if (n < 0) { return 0 - 1; }
    return mihi_parse_uptime_secs(buf, n);
    #endif
}

# ----- mihi_distro — /etc/os-release PRETTY_NAME / ID ----------------

# Find a line-anchored shell-style assignment in `buf`. `key` is the
# bare key with trailing '=' (e.g. "PRETTY_NAME="). Match position
# must be at offset 0 or be preceded by '\n'. Returns the offset of
# the first value byte (past the '='), or 0 - 1 if not found.
# Pure function — exposed for unit tests against synthetic buffers.
fn mihi_find_osrelease_key(buf, len, key, key_len): i64 {
    var i = 0;
    var found = 0 - 1;
    while (i + key_len <= len && found == 0 - 1) {
        var anchored = 0;
        if (i == 0) { anchored = 1; }
        if (i > 0 && load8(buf + i - 1) == 10) { anchored = 1; }
        if (anchored == 1) {
            var matched = 1;
            var j = 0;
            while (j < key_len && matched == 1) {
                if (load8(buf + i + j) != load8(key + j)) { matched = 0; }
                j = j + 1;
            }
            if (matched == 1) { found = i + key_len; }
        }
        i = i + 1;
    }
    return found;
}

# Given an offset `start` pointing at the first byte of a value in an
# os-release buffer, null-terminate the value in place and return a
# cstring pointer to its first character. Handles the three shapes the
# spec allows: `KEY="double quoted"`, `KEY='single quoted'`, and
# `KEY=bare-token`. For a quoted value the matching closing quote is
# overwritten with NUL; for a bare value the trailing '\n' (or EOF)
# is. Returns 0 if the value is empty or unterminated.
# Mutates `buf` (writes one NUL byte).
#
# Source: freedesktop os-release(5) — "Variable assignment values must
# be enclosed in double or single quotes if they include spaces,
# semicolons or other special characters outside of A-Z, a-z, 0-9."
#
# Single quotes were unhandled before 1.2.3 (audit finding D-3): a
# distro shipping `PRETTY_NAME='Some Linux'` fell through to the bare
# branch, which scans to the newline, so the probe returned the value
# WITH its surrounding quotes still attached. Every mainstream distro
# uses double quotes, which is why it went unnoticed — but the spec
# permits both, so accepting only one is a conformance bug, and the
# failure mode is a wrong string rather than an error.
#
# NOT handled, deliberately: the spec's backslash escaping ("Shell
# special characters ($, quotes, backslash, backtick) must be escaped
# with backslashes"). Un-escaping requires rewriting the value shorter
# and in place, and no observed distro escapes inside PRETTY_NAME or
# ID. Documented in docs/sources.md as a known limit rather than
# silently unimplemented.
fn mihi_parse_osrelease_value(buf, len, start): cstring {
    if (start >= len) { return 0; }
    var p = start;
    var v = p;
    var quote = load8(buf + p);
    if (quote == 34 || quote == 39) {
        p = p + 1;
        v = p;
        while (p < len && load8(buf + p) != quote) { p = p + 1; }
    } else {
        while (p < len && load8(buf + p) != 10) { p = p + 1; }
    }
    if (p >= len) { return 0; }
    if (v == p) { return 0; }
    store8(buf + p, 0);
    return buf + v;
}

# Read /etc/os-release into the caller-supplied `buf` (capacity `cap`,
# recommend 1024 — file is typically ~500 bytes), parse PRETTY_NAME,
# falling back to ID when PRETTY_NAME is absent (see the module header
# for what that fallback does and does not rest on). Returns cstring
# ptr into `buf` (null-terminated in place), or 0 (null) on open /
# read / truncation / parse failure.
#
# os-release(5) says /etc/os-release "should be a relative symlink to
# /usr/lib/os-release" — so this is the one probe whose path is
# expected to be a symlink, which is why the read goes through
# _mihi_read_probe_file's O_NONBLOCK open rather than O_NOFOLLOW: the
# symlink is legitimate and must be followed, but a repointed one that
# lands on a FIFO must not be allowed to hang the caller. mihi's first
# consumer renders the login MOTD; a hang there is a login denial.
# Source: man 5 os-release; freedesktop.org/software/systemd/man/os-release.html.
fn mihi_distro(buf, cap): cstring {
    #ifdef CYRIUS_TARGET_AGNOS
    # /etc/os-release is a Linux-userland concept (lives in the rootfs); on the
    # sovereign target the distro IS the OS. Report it directly.
    return "AGNOS";
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var n = _mihi_read_probe_file("/etc/os-release", buf, cap, MIHI_IO_WHOLE);
    if (n < 0) { return 0; }
    var start = mihi_find_osrelease_key(buf, n, "PRETTY_NAME=", 12);
    if (start < 0) {
        start = mihi_find_osrelease_key(buf, n, "ID=", 3);
    }
    if (start < 0) { return 0; }
    return mihi_parse_osrelease_value(buf, n, start);
    #endif
}

# --- gpu.cyr ---

# mihi/gpu — accelerator identity probes.
#
# Wraps ai-hwaccel's no-exec detection surface (contract introduced in
# 2.2.5; pinned at 2.3.18) so mihi consumers can list local GPUs /
# NPUs / TPUs / ASICs without spawning processes. The bundle's nine
# exec-shelling backends (CUDA / Apple / Vulkan / Gaudi / Neuron /
# Intel oneAPI / Cerebras / Graphcore / Windows) are masked off by
# ai-hwaccel's builder_no_exec() before any detector runs, so mihi's
# "probes are pure reads" rule is preserved end-to-end. See
# docs/development/roadmap.md M3 + ai-hwaccel/src/registry.cyr for the
# no-exec contract.
#
# Sources of truth (all sysfs/syscall — no subprocess):
#   - ROCm:       /sys/class/drm/card*/device/mem_info_vram_total
#   - Intel NPU:  /sys/class/misc/intel_npu
#   - AMD XDNA:   /sys/class/accel/accel* (amdxdna driver)
#   - TPU:        /sys/class/accel/accel* (apex_n driver, Coral)
#   - Qualcomm:   /sys/class/qaic
#   - Groq:       /dev/groq
#   - Samsung NPU:/sys/class/misc/samsung_npu
#   - MediaTek:   /sys/class/misc/mtk_apu
#   plus enrich_bandwidth/pcie/numa sysfs post-passes.
# (ai-hwaccel 2.3.x also reserves BACKEND_AGNOS_GPU in the no-exec
# mask, but ships no detector dispatch for it yet — no mihi behavior
# change until upstream wires one.)
#
# Cache model — DEPARTS from cpu/mem/kernel/host pattern.
# Module-level singleton: first call to any mihi_gpu_* probe lazy-
# initializes the registry via registry_detect_no_exec(); subsequent
# calls are O(n) walks of the cached vec. Caller still doesn't
# allocate; mihi owns the cache. On AGNOS-native this collapses to a
# single read from the boot-info struct's accelerator manifest.
# Full justification (why the singleton doesn't violate "no caching
# layer" or "no allocator dependency from probe internals"), the
# alternatives considered, and the multi-threading caveat live in
# docs/adr/0002-gpu-singleton-cache.md.
#
# Indexing convention: mihi_gpu_count() / mihi_gpu_{name,memory,
# family,type}(idx) operate on the accelerator-only view — the CPU
# profile that registry_detect_no_exec() always synthesizes is hidden.
# idx 0 is the first real accelerator; idx >= count returns 0 / 0-1.

# Module-level cache. 0 = not yet initialized; a non-zero pointer once
# _mihi_gpu_ensure() has run registry_detect_no_exec() one time.
# Never freed — the registry is process-lifetime data (matches the
# boot-info-struct lifetime on AGNOS-native).
var _mihi_gpu_registry = 0;

# ai-hwaccel 2.3.x routes its detect-path diagnostics through `sakshi`,
# whose default level is SK_INFO — so registry_detect_no_exec() writes
# "detect: profiles=N" to the consumer's stderr. ai-hwaccel's own
# programs suppress that by calling hwlog_init() (which sets SK_WARN);
# mihi is a library, so it must neither write to a consumer's stderr nor
# permanently reset a level the consumer chose. Clamp to SK_WARN across
# the one detect call, then restore the caller's level. Process-local
# state, saved and put back — "probes are pure reads" (no file/system
# mutation, no subprocess) is unaffected.
fn _mihi_gpu_ensure() {
    var prev_level = 0;
    if (_mihi_gpu_registry == 0) {
        prev_level = sakshi_get_level();
        if (prev_level > SK_WARN) { sakshi_set_level(SK_WARN); }
        _mihi_gpu_registry = registry_detect_no_exec();
        sakshi_set_level(prev_level);
    }
    return _mihi_gpu_registry;
}

# Map accelerator-index (0..mihi_gpu_count()) → registry profile,
# skipping the synthetic CPU profile ai-hwaccel always emits at the
# head. Returns 0 if idx is out of range.
fn _mihi_gpu_profile(idx) {
    var r = _mihi_gpu_ensure();
    var profs = reg_profiles(r);
    var n = vec_len(profs);
    var seen = 0;
    var i = 0;
    while (i < n) {
        var p = vec_get(profs, i);
        if (profile_family(p) != FAMILY_CPU) {
            if (seen == idx) { return p; }
            seen = seen + 1;
        }
        i = i + 1;
    }
    return 0;
}

# ----- mihi_gpu_count — accelerators detected ------------------------

# Returns the number of accelerators (GPUs / NPUs / TPUs / AI ASICs)
# detected via the no-exec backends. Excludes the synthetic CPU
# profile. Lazy-initializes the registry on first call across the
# whole gpu probe family.
# Source: ai-hwaccel registry_detect_no_exec() with builder_no_exec().
fn mihi_gpu_count(): i64 {
    var r = _mihi_gpu_ensure();
    var profs = reg_profiles(r);
    var n = vec_len(profs);
    var c = 0;
    var i = 0;
    while (i < n) {
        var p = vec_get(profs, i);
        if (profile_family(p) != FAMILY_CPU) {
            c = c + 1;
        }
        i = i + 1;
    }
    return c;
}

# ----- mihi_gpu_name — device name -----------------------------------

# Returns the device name for accelerator `idx` as a cstring pointer
# into ai-hwaccel's internal storage. Stable for process lifetime
# (the registry is never freed — see file header). Returns 0 (null)
# if idx is out of range.
# Source: profile_device_name, set by each detect_<backend> from the
# sysfs node that names the device (e.g. /sys/class/drm/cardN/device/
# product_name for ROCm, hardcoded vendor strings for the
# fixed-identity NPU backends).
fn mihi_gpu_name(idx): cstring {
    var p = _mihi_gpu_profile(idx);
    if (p == 0) { return 0; }
    return profile_device_name(p);
}

# ----- mihi_gpu_memory_bytes — total accelerator memory --------------

# Returns total on-device memory for accelerator `idx` in bytes.
# Returns 0 - 1 if idx is out of range.
# Source: profile_memory_bytes — ROCm reads
# /sys/class/drm/cardN/device/mem_info_vram_total; per-NPU backends
# use vendor-documented fixed sizes (e.g. Intel NPU 2 GiB, Qualcomm
# 32 GiB) where sysfs doesn't expose memory.
fn mihi_gpu_memory_bytes(idx): i64 {
    var p = _mihi_gpu_profile(idx);
    if (p == 0) { return 0 - 1; }
    return profile_memory_bytes(p);
}

# ----- mihi_gpu_family — FAMILY_* tag --------------------------------

# Returns the family tag (FAMILY_GPU / FAMILY_NPU / FAMILY_TPU /
# FAMILY_AI_ASIC) for accelerator `idx`. Returns 0 - 1 if idx is out
# of range. Family constants are defined in ai-hwaccel's types.cyr
# and bundled into lib/ai-hwaccel.cyr.
# Source: accel_family(profile_accel_type(p)) — pure mapping from the
# 18-variant AcceleratorType enum to the 4-variant family enum.
fn mihi_gpu_family(idx): i64 {
    var p = _mihi_gpu_profile(idx);
    if (p == 0) { return 0 - 1; }
    return profile_family(p);
}

# ----- mihi_gpu_type — ACCEL_* tag -----------------------------------

# Returns the precise accelerator-type tag (one of the ACCEL_* enum
# variants from ai-hwaccel: ROCm, Intel NPU, AMD XDNA, TPU, Qualcomm,
# Groq, Samsung NPU, MediaTek APU — under the no-exec mask). Returns
# 0 - 1 if idx is out of range.
# Source: profile_accel_type — set by each detect_<backend> at
# profile_new() time.
fn mihi_gpu_type(idx): i64 {
    var p = _mihi_gpu_profile(idx);
    if (p == 0) { return 0 - 1; }
    return profile_accel_type(p);
}

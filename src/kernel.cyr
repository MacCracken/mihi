# mihi/kernel — kernel identity probes.
#
# Linux source of truth: uname(2) — see man 2 uname / asm-generic/utsname.h.
# The kernel writes a 390-byte struct utsname split into six 65-byte
# null-terminated fields. We need sysname (offset 0) and release
# (offset 130). lib/sys.cyr provides the raw uname syscall; we
# layer field-accessors named after the mihi probe surface on top.
#
# AGNOS: the same probes read AGNOS's own uname syscall (#34), whose
# 64-byte struct is four fixed 16-byte slots (agnos-userland-abi.md
# §4.3); lib/sys.cyr carries the per-target offsets. That is a native
# path, not a faked Linux one, and it has shipped since 1.1.2 / 1.1.3.
# Through 1.3.1 this comment still said the AGNOS path would "land when
# AGNOS has a stable boot-info ABI" and that the bodies were Linux-only
# (audit E-2). Whether the boot-info struct should replace the syscall
# is an open roadmap decision (1.7.x).
#
# Buffer contract (see docs/adr/0001-shared-uts-buffer.md):
#   Caller allocates uts[UTS_SIZE] on its stack, calls mihi_uname(uts)
#   once, then reads whichever fields it wants. mihi owns no state.

# uname(2) / sysinfo(2) wrappers and their per-target UTS_* / SI_* offsets.
include "lib/sys.cyr"

# MIHI_UTS_FIELD — the width of one utsname slot. Linux: 65
# (__NEW_UTS_LEN 64 + NUL; six slots, 390 bytes). AGNOS: 16, four slots,
# 64 bytes, and per agnos-userland-abi.md §4.3 "NUL-padded to fill the
# slot (not NUL-terminated-and-variable)". So a 16-character AGNOS value
# carries no terminator.
#ifdef CYRIUS_TARGET_AGNOS
enum MihiUtsLayout { MIHI_UTS_FIELD = 16; }
#endif
#ifndef CYRIUS_TARGET_AGNOS
enum MihiUtsLayout { MIHI_UTS_FIELD = 65; }
#endif

# Zero every `width`-byte slot of the `size`-byte utsname at `uts` that
# holds no NUL, so each field accessor's cstring ends inside its own slot.
# Returns how many slots it zeroed. Pure.
#
# Audit B-10 (2026-10-29): the accessors return `uts + UTS_X` as a
# cstring and so need a NUL inside the slot. Linux guarantees one. AGNOS
# does not: a 16-character value fills its slot exactly. Then
# mihi_kernel_version runs on into the machine slot, and mihi_cpu_arch
# (the last slot) runs past the 64-byte buffer the ADR 0001 contract
# has the caller allocate. Today's longest AGNOS value is 7 characters,
# so nothing trips this yet. A full slot is reported as an empty field,
# the same honest "unknown" A-4 gives a failed call, rather than cut to
# 15 characters, which would be a plausible wrong value.
fn _mihi_uts_seal(uts, size, width): i64 {
    if (width <= 0) { return 0; }
    var zeroed = 0;
    var base = 0;
    while (base + width <= size) {
        var k = 0;
        var nul = 0;
        while (k < width && nul == 0) {
            if (load8(uts + base + k) == 0) { nul = 1; }
            k = k + 1;
        }
        if (nul == 0) {
            k = 0;
            while (k < width) {
                store8(uts + base + k, 0);
                k = k + 1;
            }
            zeroed = zeroed + 1;
        }
        base = base + width;
    }
    return zeroed;
}

# Fill `uts` (must point to at least UTS_SIZE bytes — 390 on Linux,
# 64 on AGNOS) with the current kernel's utsname struct. Returns
# Result: Ok(uts) or Err.
# Source: uname(2) — Linux kernel arch/*/kernel/sys.c::sys_newuname.
#
# ⛔ CALLER CONTRACT CHANGED AT 1.2.6 (cyrius 6.6.0). `Result` is now the
# VALUE FORM — `enum Result<T, E>: stack` hands back a REGISTER PAIR
# (tag in rax, payload in rdx) instead of a 16-byte box, so this is the
# only correct receive:
#
#     var t, v = mihi_uname(&uts);   # bind BOTH halves
#     if (is_err_result(t) == 1) { ... }
#
# The old single-variable `var r = mihi_uname(&uts);` is a hard compile
# ERROR naming the fix — it would keep the tag and silently drop the
# payload. That diagnostic is the migration tool: every stale consumer
# site fails at its own line rather than miscompiling. `is_ok` /
# `is_err_result` are unchanged (argument 1 receives rax, which IS the
# tag); `payload()` is gone, and under the value form the payload is
# already a plain variable. See lib/result.cyr and cyrius CHANGELOG
# [6.6.0].
#
# Hardened at the 2026-08-23 audit (finding A-4): the buffer is zeroed
# BEFORE the syscall. The four field accessors (mihi_kernel_name /
# mihi_kernel_version / mihi_cpu_arch / mihi_hostname) are pure pointer
# math and, by the ADR 0001 contract, do not verify that this call
# succeeded. A caller that ignores the Result and reads a field after a
# failed uname was therefore handed a pointer into UNINITIALISED STACK
# and a "cstring" with no terminator in it — so the consumer's
# println() walks off the buffer. That is the one place in mihi where a
# caller mistake turned into an out-of-bounds read rather than a wrong
# value. Zeroing first costs UTS_SIZE byte-stores once per process and
# converts the worst case from an OOB walk into an empty string, which
# is exactly what the "zero-init uts" test already asserts is safe.
# lib/sys.cyr's macOS arm zeroes for the same reason.
fn mihi_uname(uts): i64 {
    var z = 0;
    while (z < UTS_SIZE) {
        store8(uts + z, 0);
        z = z + 1;
    }
    # sys_uname (lib/sys.cyr) returns raw 0 / -errno; wrap as Result for callers
    # that check is_ok / is_err_result (iam) — see the value-form bind rule in
    # this function's header comment. The UTS_* offsets resolve
    # target-correct from sys.cyr — AGNOS: sysname@0 / nodename@16 / release@32 /
    # machine@48 in the sovereign 64-byte struct; Linux: the 390-byte layout.
    var rc = sys_uname(uts);
    if (rc != 0) { return Err(rc); }
    # AGNOS only: Linux guarantees the NUL (uname(2); sethostname(2) refuses
    # more than 64 bytes and zero-fills the slot), and sealing six slots
    # there cost ~320 ns a call for nothing.
    #ifdef CYRIUS_TARGET_AGNOS
    _mihi_uts_seal(uts, UTS_SIZE, MIHI_UTS_FIELD);
    #endif
    return Ok(uts);
}

# Return a pointer to the null-terminated sysname field within `uts`.
# Caller must have already filled `uts` via mihi_uname.
# Source: utsname.sysname (offset 0, see sys.cyr UTS_SYSNAME) —
# kernel UTS namespace, written at boot. On Linux this is "Linux".
# Returns cstring so println() dispatches to the string overload.
fn mihi_kernel_name(uts): cstring {
    return uts + UTS_SYSNAME;
}

# Return a pointer to the null-terminated release field within `uts`.
# Source: utsname.release — `uname -r` output;
# arch/*/include/generated/utsrelease.h baked at kernel build time.
fn mihi_kernel_version(uts): cstring {
    return uts + UTS_RELEASE;
}

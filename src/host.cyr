# mihi/host — host identity probes.
#
# Three small probes that close the "tell me about this box" surface
# for the login MOTD path: hostname, system uptime, distro PRETTY_NAME.
#
# Sources of truth:
#   - hostname: uname(2).nodename — shares the uts buffer the kernel /
#     CPU-arch probes already populate (ADR 0001). One syscall covers
#     four facts.
#   - uptime:   /proc/uptime first whitespace-separated field, seconds
#     with fractional precision. Kernel writes ~64 bytes — caller's
#     scratch buffer of ~64 bytes is plenty.
#   - distro:   /etc/os-release PRETTY_NAME (shell-style key=value,
#     values optionally single- OR double-quoted per the spec). Falls
#     back to ID when PRETTY_NAME is absent — the only fallback in
#     mihi. Its justification was corrected at the 2026-08-23 audit
#     (finding D-2): os-release(5) marks PRETTY_NAME optional, and it
#     marks ID optional too ("If not set, a default of ID=linux may be
#     used") — so ID is NOT "the mandatory minimum every distro ships",
#     as this comment used to claim. The fallback stands on weaker but
#     still real ground: the two keys are the only ones that name the
#     OS, PRETTY_NAME is what a human wants, and ID is what is left. A
#     file carrying neither yields a null return, not a guess.
#     /etc/os-release is small (~1 kB in practice) so a 1 KiB scratch
#     buffer is sufficient.
#
# AGNOS: hostname comes from AGNOS's uname syscall (#34) and uptime
# from its sysinfo (#35), both through lib/sys.cyr, shipped at 1.1.2 /
# 1.1.3. distro is a Linux-userland concept and reports "AGNOS". Through
# 1.3.1 this said hostname and uptime would come from a boot-info struct
# and a future clock primitive (audit E-2).

# uname(2) / sysinfo(2) wrappers and their per-target UTS_* / SI_* offsets.
include "lib/sys.cyr"

# ----- mihi_hostname — uname.nodename --------------------------------

# Return a pointer to the null-terminated nodename field within `uts`.
# Caller must have already filled `uts` via mihi_uname.
# Source: utsname.nodename (offset 65, see sys.cyr UTS_NODENAME) —
# kernel UTS namespace, set by sethostname(2) at boot. On systems
# without a hostname configured the kernel reports "(none)".
# Returns cstring so println() dispatches to the string overload.
fn mihi_hostname(uts): cstring {
    return uts + UTS_NODENAME;
}

# ----- mihi_uptime_secs — /proc/uptime first field -------------------

# Parse the integer-seconds prefix of a /proc/uptime buffer: digits
# accumulate until any non-digit byte (typically '.' for the fractional
# part, ' ' between fields, or '\n'). Returns 0 - 1 if no leading
# digit. Pure parser — exposed for unit tests.
# Source: kernel fs/proc/uptime.c::uptime_proc_show — writes
# "%lu.%02lu %lu.%02lu\n" (uptime seconds + idle seconds).
#
# Defensive (2026-05-19 audit C-2): caps digit count at 18 to defend
# against integer overflow on adversarial /proc/uptime content. Real
# kernel uptime is bounded by clock resolution and process lifetime;
# 10 digits covers ~300 years.
#
# Defensive (2026-10-29 audit B-2): past the cap is an error. Through
# 1.3.1 a 19-digit uptime came back as its first 18 digits, a plausible
# wrong number, and nothing downstream rejected it.
fn mihi_parse_uptime_secs(buf, len): i64 {
    if (len <= 0) { return 0 - 1; }
    var e[8];
    var v = _mihi_parse_uint(buf, len, 0, &e);
    if (v < 0) { return 0 - 1; }
    return v;
}

# Read /proc/uptime into the caller-supplied `buf` (capacity `cap`,
# recommend 64 — file is ~32 bytes), parse the first whitespace-
# separated field as decimal seconds, drop the fractional part.
# Returns 0 - 1 on open/read/parse failure.
# Source: man 5 proc; kernel fs/proc/uptime.c::uptime_proc_show().
fn mihi_uptime_secs(buf, cap): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # AGNOS has no /proc/uptime — uptime comes from sysinfo#35 (SI_UPTIME, secs).
    var si[120];
    if (sys_sysinfo(&si) != 0) { return 0 - 1; }
    var up = sysinfo_uptime(&si);
    if (up < 0) { return 0 - 1; }   # a u64 past i64 max (audit B-9)
    return up;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var n = _mihi_read_probe_file("/proc/uptime", buf, cap, MIHI_IO_WHOLE);
    if (n < 0) { return 0 - 1; }
    return mihi_parse_uptime_secs(buf, n);
    #endif
}

# ----- mihi_distro — /etc/os-release PRETTY_NAME / ID ----------------

# Find a line-anchored shell-style assignment in `buf`. `key` is the
# bare key with trailing '=' (e.g. "PRETTY_NAME="). Match position
# must be at offset 0 or be preceded by '\n'. Returns the offset of
# the first value byte (past the '='), or 0 - 1 if not found.
# Pure function — exposed for unit tests against synthetic buffers.
# Since 1.3.2 this is the shared line-anchored scan in io.cyr.
fn mihi_find_osrelease_key(buf, len, key, key_len): i64 {
    return _mihi_find_line_prefix(buf, len, key, key_len);
}

# Given an offset `start` pointing at the first byte of a value in an
# os-release buffer, null-terminate the value in place and return a
# cstring pointer to its first character. Handles the three shapes the
# spec allows: `KEY="double quoted"`, `KEY='single quoted'`, and
# `KEY=bare-token`. For a quoted value the matching closing quote is
# overwritten with NUL; for a bare value the trailing '\n' is. Returns 0
# if the value is empty or unterminated, and that includes a bare value
# that runs to the end of `buf` with no newline. mihi_distro guarantees
# the newline, but this function cannot write past `len` (through 1.3.1
# this comment said "(or EOF)", which the code never did). Mutates
# `buf` (writes one NUL byte) on success only.
#
# Defensive (2026-10-29 audit B-5): a quoted value ends at its line. An
# os-release assignment is one line, so a closing quote is only looked
# for before the next '\n'. Through 1.3.1 the scan ran on into later
# lines: `PRETTY_NAME="Foo` with no closing quote, followed by
# `NAME="Bar"`, came back as the multi-line value `Foo\nNAME=`.
# /etc/os-release is the one input mihi reads that a package or a
# container image writes.
#
# Source: freedesktop os-release(5) — "Variable assignment values must
# be enclosed in double or single quotes if they include spaces,
# semicolons or other special characters outside of A-Z, a-z, 0-9."
#
# Single quotes were unhandled before 1.2.3 (audit finding D-3): a
# distro shipping `PRETTY_NAME='Some Linux'` fell through to the bare
# branch, which scans to the newline, so the probe returned the value
# WITH its surrounding quotes still attached. Every mainstream distro
# uses double quotes, which is why it went unnoticed — but the spec
# permits both, so accepting only one is a conformance bug, and the
# failure mode is a wrong string rather than an error.
#
# NOT handled, deliberately: the spec's backslash escaping ("Shell
# special characters ($, quotes, backslash, backtick) must be escaped
# with backslashes"). Un-escaping requires rewriting the value shorter
# and in place, and no observed distro escapes inside PRETTY_NAME or
# ID. Documented in docs/sources.md as a known limit rather than
# silently unimplemented.
fn mihi_parse_osrelease_value(buf, len, start): cstring {
    # A negative `start` (a missing key) is 0. Through 1.3.1 it returned
    # a pointer one byte before `buf` (audit B-12).
    if (start < 0) { return 0; }
    if (start >= len) { return 0; }
    var p = start;
    var v = p;
    var quote = load8(buf + p);
    if (quote == 34 || quote == 39) {
        p = p + 1;
        v = p;
        while (p < len && load8(buf + p) != quote && load8(buf + p) != 10) { p = p + 1; }
        if (p < len && load8(buf + p) == 10) { return 0; }   # unterminated on its line
    } else {
        while (p < len && load8(buf + p) != 10) { p = p + 1; }
    }
    if (p >= len) { return 0; }
    if (v == p) { return 0; }
    store8(buf + p, 0);
    return buf + v;
}

# Read /etc/os-release into the caller-supplied `buf` (capacity `cap`,
# recommend 1024 — file is typically ~500 bytes), parse PRETTY_NAME,
# falling back to ID when PRETTY_NAME is absent (see the module header
# for what that fallback does and does not rest on). Returns cstring
# ptr into `buf` (null-terminated in place), or 0 (null) on open /
# read / truncation / parse failure.
#
# os-release(5) says /etc/os-release "should be a relative symlink to
# /usr/lib/os-release" — so this is the one probe whose path is
# expected to be a symlink, which is why the read goes through
# _mihi_read_probe_file's O_NONBLOCK open rather than O_NOFOLLOW: the
# symlink is legitimate and must be followed, but a repointed one that
# lands on a FIFO must not be allowed to hang the caller. mihi's first
# consumer renders the login MOTD; a hang there is a login denial.
# Source: man 5 os-release; freedesktop.org/software/systemd/man/os-release.html.
#
# Two 1.3.2 changes (2026-10-29 audit B-6, B-7):
#   - The read leaves one byte of `cap` spare, and a file whose last line
#     has no newline gets one there. os-release(5) does not require a
#     trailing newline, and through 1.3.1 a bare value on that last line
#     (`ID=arch` at EOF) returned null. So the file must now fit in
#     `cap - 1` bytes.
#   - The ID fallback also covers a PRETTY_NAME that is present but
#     unusable (empty, or a quote left open), not only an absent one.
#     A failed parse writes nothing, so the second key is read from the
#     same, unmodified buffer.
fn mihi_distro(buf, cap): cstring {
    #ifdef CYRIUS_TARGET_AGNOS
    # /etc/os-release is a Linux-userland concept (lives in the rootfs); on the
    # sovereign target the distro IS the OS. Report it directly, written into
    # `buf` as the contract above says. Through 1.3.1 this returned the string
    # literal itself, so a consumer editing the result in place edited the
    # literal (audit B-13).
    var ag = "AGNOS";
    if (cap < 6) { return 0; }
    var k = 0;
    while (k < 6) {
        store8(buf + k, load8(ag + k));
        k = k + 1;
    }
    return buf;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (cap < 2) { return 0; }
    var n = _mihi_read_probe_file("/etc/os-release", buf, cap - 1, MIHI_IO_WHOLE);
    if (n < 0) { return 0; }
    return _mihi_osrelease_pick(buf, n, cap);
    #endif
}

# mihi_distro after the read: `buf` holds `n` bytes of os-release, and
# `cap` is its capacity. Give a last line with no newline one (when
# n < cap), then PRETTY_NAME, else ID. Returns a cstring into `buf`, or 0.
# Pure, so the tests can drive the edge cases without touching
# /etc/os-release.
fn _mihi_osrelease_pick(buf, n, cap): cstring {
    if (n <= 0) { return 0; }
    if (load8(buf + n - 1) != 10 && n < cap) {
        store8(buf + n, 10);
        n = n + 1;
    }
    var v = 0;
    var start = mihi_find_osrelease_key(buf, n, "PRETTY_NAME=", 12);
    if (start >= 0) { v = mihi_parse_osrelease_value(buf, n, start); }
    if (v != 0) { return v; }
    start = mihi_find_osrelease_key(buf, n, "ID=", 3);
    if (start < 0) { return 0; }
    return mihi_parse_osrelease_value(buf, n, start);
}

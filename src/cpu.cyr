# mihi/cpu — CPU probes.
#
# Slice A: mihi_cpu_arch via uname.machine (shares uts buffer with
# kernel.cyr per ADR 0001).
#
# Slice B: mihi_cpu_count via /sys/devices/system/cpu/online,
# mihi_cpu_model via /proc/cpuinfo first block. Both follow the
# read-into-caller-buffer convention; cpu_count's return is an
# integer so it uses a stack-local scratch buffer.

# `cyrius build --agnos` does NOT predefine CYRIUS_ARCH_X86 (only a native x86 build
# does), so the CPUID brand asm below (guarded #ifdef CYRIUS_ARCH_X86) was compiled
# OUT on agnos → CPU rendered "(unknown)" while iam ran fine. agnos IS x86, so map it:
# (a future aarch64-agnos would set CYRIUS_ARCH_AARCH64 and skip this.)
#ifdef CYRIUS_TARGET_AGNOS
#define CYRIUS_ARCH_X86
#endif

# ----- Slice A — uname.machine -------------------------------------

# Return a pointer to the null-terminated machine field within `uts`.
# Caller must have already filled `uts` via mihi_uname.
# Source: utsname.machine (offset 260, see sys.cyr UTS_MACHINE) —
# kernel arch identifier ("x86_64", "aarch64", etc.). On AGNOS-native
# this will eventually come from the boot-info struct instead.
# Returns cstring so println() dispatches to the string overload.
fn mihi_cpu_arch(uts): cstring {
    return uts + UTS_MACHINE;
}

# ----- Slice B — /sys/devices/system/cpu/online --------------------

# MIHI_CPU_MAX — sanity ceiling on a parsed logical-CPU count. Linux's
# CONFIG_NR_CPUS tops out at 8192 (x86_64 MAXSMP) / 16384 (arm64); 2^20
# is two orders of magnitude clear of both, so nothing real trips it and
# only corrupt input does. See mihi_parse_cpu_range.
#
# MIHI_CPU_ONLINE_CAP — read capacity for /sys/devices/system/cpu/online,
# mirrored by the `var online[1024]` declaration in mihi_cpu_count (array
# sizes take literals). The file is "0-15" on a normal box, but the
# kernel emits a %*pbl range list, so a machine with many offline CPUs
# produces a long comma-separated list. 64 bytes (the pre-1.2.3 size)
# truncated such a list mid-range and returned a plausible wrong count.
enum MihiCpuLimit {
    MIHI_CPU_MAX = 1048576;
    MIHI_CPU_ONLINE_CAP = 1024;
}

# Parse a CPU range string like "0-15" or "0-3,5-7" or "0" into a
# logical-CPU count. Sums (hi-lo+1) per comma-separated range; bare
# "N" is treated as N-N. Whitespace, newlines, and commas are
# separators. Returns 0 if no digits found.
# Source: Documentation/admin-guide/cputopology.rst, %*pbl format.
# Pure-function — testable with synthetic buffers, no syscall.
#
# Defensive (2026-05-19 audit C-1, C-2):
#   - Caps each digit accumulator at 18 digits (~10^18, well under
#     i64 max). Prevents overflow on adversarial /sys content; the
#     real kernel never emits more than ~5 digits per range bound.
#   - Coerces descending ranges (hi < lo, e.g. "10-5") to single-CPU
#     ranges. Real kernel output is always ascending; this defends
#     against a corrupted /sys file producing a negative addend.
#
# Defensive (2026-08-23 audit A-2): the per-range digit cap bounds each
# *addend* to < 10^18, but `total` accumulated without any bound — ten
# such ranges overflow i64 and the count comes back negative. The 64-byte
# read buffer used to make that unreachable by arithmetic; A-1 grew the
# buffer to 1024, so it stopped being unreachable. Any total above
# MIHI_CPU_MAX (2^20 — two orders of magnitude past Linux's 8192-CPU
# CONFIG_NR_CPUS ceiling) means corrupt input, and the function reports
# malformed input the way it already does elsewhere: return 0.
fn mihi_parse_cpu_range(buf, len): i64 {
    var total = 0;
    var i = 0;
    var done = 0;
    while (done == 0) {
        # skip separators (' ', '\n', ',')
        while (i < len && (load8(buf + i) == 32 || load8(buf + i) == 10 || load8(buf + i) == 44)) {
            i = i + 1;
        }
        if (i >= len) {
            done = 1;
            continue;
        }
        var c0 = load8(buf + i);
        if (c0 < 48 || c0 > 57) {
            # non-digit, non-separator — malformed; stop counting.
            done = 1;
            continue;
        }
        # parse lo (cap 18 digits — audit C-2 / overflow defense)
        var lo = 0;
        var ld = 0;
        while (i < len && load8(buf + i) >= 48 && load8(buf + i) <= 57 && ld < 18) {
            lo = lo * 10 + (load8(buf + i) - 48);
            ld = ld + 1;
            i = i + 1;
        }
        # optional -hi
        var hi = lo;
        if (i < len && load8(buf + i) == 45) {
            i = i + 1;
            hi = 0;
            var hd = 0;
            while (i < len && load8(buf + i) >= 48 && load8(buf + i) <= 57 && hd < 18) {
                hi = hi * 10 + (load8(buf + i) - 48);
                hd = hd + 1;
                i = i + 1;
            }
        }
        # Coerce descending ranges (audit C-1).
        if (hi < lo) { hi = lo; }
        total = total + (hi - lo + 1);
        # Overflow guard (audit A-2). Checked every iteration, so `total`
        # can never climb far enough to wrap: each addend is < 10^18 and
        # the guard trips at 2^20, so the largest value `total` can hold
        # is ~10^18 — three orders of magnitude below i64 max.
        if (total > MIHI_CPU_MAX) {
            total = 0;
            done = 1;
        }
    }
    return total;
}

# Count logical CPUs from /sys/devices/system/cpu/online.
# Returns logical CPU count, or 0 - 1 on open/read/truncation error.
# Source: kernel/cpu.c::cpu_online_mask exported via sysfs, formatted
# with %*pbl (Documentation/admin-guide/cputopology.rst).
fn mihi_cpu_count(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # AGNOS has no /sys — read the enumerated CPU count from sysinfo#35 (§4.4 `cpus`
    # @ SI_CPUS=32; was a stale hardcoded 1). The buffer is sized 120 to match every
    # other sysinfo call site in mihi rather than the 40 bytes AGNOS §4.4 currently
    # needs: sys_sysinfo passes its own length to the kernel, so the extra bytes cost
    # one stack frame and remove a size that would have to be revisited if §4.4 grows.
    var info[120];
    var rc = sys_sysinfo(&info);
    if (rc != 0) { return 0 - 1; }
    var n = load64(&info + SI_CPUS);
    if (n < 1) { return 1; }
    return n;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var online[1024];   # MIHI_CPU_ONLINE_CAP
    var n = _mihi_read_probe_file("/sys/devices/system/cpu/online", &online, MIHI_CPU_ONLINE_CAP, MIHI_IO_WHOLE);
    if (n < 0) { return 0 - 1; }
    return mihi_parse_cpu_range(&online, n);
    #endif
}

# ----- Slice B — /proc/cpuinfo model name ---------------------------

# Scan `buf` (length `len`, freshly read from /proc/cpuinfo) for the
# first "model name" line, null-terminate the value in place by
# overwriting its trailing newline, and return a cstring pointer to
# the value's first character. Returns 0 (null) if not found.
#
# /proc/cpuinfo on Linux always begins with "processor\t: 0\n", so
# "model name" is preceded by '\n' — we search for "\nmodel name"
# rather than worrying about file-start. This naturally pins us to
# CPU 0's block, satisfying "one source per fact" on heterogeneous
# big.LITTLE parts.
#
# Mutates `buf` (writes a single NUL byte). Pure parser otherwise —
# unit-testable against a synthetic cpuinfo buffer.
fn mihi_parse_cpu_model(buf, len): cstring {
    var target = "\nmodel name";
    var tlen = 11;
    var i = 0;
    var found = 0 - 1;
    while (i + tlen <= len && found == 0 - 1) {
        # "matched" not "match" — match is a reserved keyword in cyrius.
        var matched = 1;
        var j = 0;
        while (j < tlen && matched == 1) {
            if (load8(buf + i + j) != load8(target + j)) { matched = 0; }
            j = j + 1;
        }
        if (matched == 1) { found = i + 1; }  # +1 skips the leading '\n'
        i = i + 1;
    }
    if (found == 0 - 1) { return 0; }
    # Skip past "model name" (10 bytes), then any \t/space/':' before the value.
    var p = found + 10;
    while (p < len && (load8(buf + p) == 9 || load8(buf + p) == 32 || load8(buf + p) == 58)) {
        p = p + 1;
    }
    if (p >= len) { return 0; }
    var start = p;
    while (p < len && load8(buf + p) != 10) { p = p + 1; }
    if (p >= len) { return 0; }
    store8(buf + p, 0);
    return buf + start;
}

# ----- Slice B (agnos / sovereign) — CPUID processor brand string ---
#
# /proc/cpuinfo is Linux-only; AGNOS has no procfs, so the model line rendered
# "(unknown)" there. The brand string is the SAME datum Linux's "model name"
# derives from: CPUID leaves 0x80000002/3/4 return 48 bytes (EAX/EBX/ECX/EDX
# each) — the human "AMD Ryzen … " / "Intel(R) Core … " string. This path works
# bare-metal on any x86 target (agnos AND Linux), so it is validated on the Linux
# host against /proc/cpuinfo before it ever ships to agnos.

# Fill buf[0..47] with the raw 48-byte CPUID brand string. x86 only.
# Returns 1 on x86, 0 otherwise.
#
# ⚠ `buf` MUST be >= 48 bytes, and this function CANNOT CHECK THAT — it
# takes no capacity parameter and stores 48 bytes unconditionally. The
# only in-tree caller, mihi_cpu_model_cpuid, rejects `cap < 49` before
# reaching here. Audit finding A-7 (2026-08-23): the name carries no
# leading underscore, so this is on the bundle's public surface and a
# consumer could call it directly with a short buffer. Adding a `cap`
# parameter is a signature change and the API has been frozen since
# 1.0.0, so it is a v2.0 item; until then this comment is the contract.
# The 48 bytes come from the `cpuid` instruction, not from any file, so
# nothing attacker-controlled reaches the store.
#
# `param_load(rdi, 0)` loads param 0 (`buf`) into rdi with the slot offset resolved
# at EMIT TIME (cyrius 6.0.67+) — prologue-drift-proof, the sigil `_sha_ni_cpuid_probe`
# idiom. (v1.2.0 instead HAND-ASSUMED `buf` stayed in rdi from the SysV entry: that
# held on the Linux build but the agnos codegen's prologue clobbered rdi → `[rdi+N]`
# wrote to garbage → iam faulted, `run: exit 142`, caught in QEMU by iam-agnos-verify —
# NOT on iron.) cpuid clobbers rax/rbx/rcx/rdx (rbx push/pop'd per leaf) but not rdi,
# so `buf` persists across all 3 leaves after the single param_load.
fn mihi_cpu_brand_fill(buf): i64 {
    #ifdef CYRIUS_ARCH_X86
    asm {
        param_load(rdi, 0);            # buf (param 0) — prologue-drift-proof
        0xB8; 0x02; 0x00; 0x00; 0x80;  # mov eax, 0x80000002
        0x53;                          # push rbx
        0x0F; 0xA2;                    # cpuid
        0x89; 0x07;                    # mov [rdi],    eax
        0x89; 0x5F; 0x04;              # mov [rdi+4],  ebx
        0x89; 0x4F; 0x08;              # mov [rdi+8],  ecx
        0x89; 0x57; 0x0C;              # mov [rdi+12], edx
        0x5B;                          # pop rbx
        0xB8; 0x03; 0x00; 0x00; 0x80;  # mov eax, 0x80000003
        0x53;                          # push rbx
        0x0F; 0xA2;                    # cpuid
        0x89; 0x47; 0x10;              # mov [rdi+16], eax
        0x89; 0x5F; 0x14;              # mov [rdi+20], ebx
        0x89; 0x4F; 0x18;              # mov [rdi+24], ecx
        0x89; 0x57; 0x1C;              # mov [rdi+28], edx
        0x5B;                          # pop rbx
        0xB8; 0x04; 0x00; 0x00; 0x80;  # mov eax, 0x80000004
        0x53;                          # push rbx
        0x0F; 0xA2;                    # cpuid
        0x89; 0x47; 0x20;              # mov [rdi+32], eax
        0x89; 0x5F; 0x24;              # mov [rdi+36], ebx
        0x89; 0x4F; 0x28;              # mov [rdi+40], ecx
        0x89; 0x57; 0x2C;              # mov [rdi+44], edx
        0x5B;                          # pop rbx
    }
    return 1;
    #endif
    #ifndef CYRIUS_ARCH_X86
    return 0;
    #endif
}

# CPUID brand → trimmed, NUL-terminated cstring in `buf`. `cap` must be >= 49
# (48 brand bytes + NUL). Strips trailing padding (AMD NUL-pads, Intel space-pads)
# and skips Intel's leading-space left-pad. Returns a cstring into `buf`, or 0 on
# non-x86 / too-small buf / all-blank brand.
fn mihi_cpu_model_cpuid(buf, cap): cstring {
    if (cap < 49) { return 0; }
    if (mihi_cpu_brand_fill(buf) == 0) { return 0; }   # non-x86
    store8(buf + 48, 0);
    # strip trailing spaces / NULs
    var end = 48;
    while (end > 0 && (load8(buf + end - 1) == 32 || load8(buf + end - 1) == 0)) {
        end = end - 1;
    }
    store8(buf + end, 0);
    # skip leading spaces (Intel left-pads the brand)
    var start = 0;
    while (start < end && load8(buf + start) == 32) {
        start = start + 1;
    }
    if (start >= end) { return 0; }   # all blank → treat as probe failure
    return buf + start;
}

# Read /proc/cpuinfo into the caller-supplied `buf` (capacity `cap`,
# recommend 8192). Returns cstring ptr into `buf` to the null-terminated
# model string, or 0 (null) on open/read/parse failure.
#
# 8192 is NOT "the file fits" and never was — /proc/cpuinfo is one block
# per logical CPU and measures 26 kB on a 16-thread box, growing with
# core count. It is "CPU 0's block fits", which is all this probe wants
# (see mihi_parse_cpu_model on why it anchors to the first block). So
# this is the one read in mihi that passes MIHI_IO_PREFIX: a short read
# is the expected case, not an error. That is safe only because the
# parser cannot return a partial value — if the buffer ends before the
# line's closing newline it returns 0, never half a brand string.
# Source: fs/proc/cpuinfo.c → arch-specific show_cpuinfo(), i.e.
# arch/x86/kernel/cpu/proc.c. The "model name" field is the human brand
# string from CPUID brand-string leaves 0x80000002/3/4.
#
# ⚠ x86 only, and that is a property of the kernel, not of this parser.
# arm64's c_show() (arch/arm64/kernel/cpuinfo.c) emits "processor",
# "BogoMIPS", "Features", "CPU implementer", "CPU architecture",
# "CPU variant", "CPU part", "CPU revision" — and no "model name" line
# at all. So on aarch64 Linux this probe returns 0, and a consumer must
# render null as "unknown" rather than assume a string. (Corrected at
# the 2026-08-23 audit, finding D-1: the comment here previously cited
# a device-tree /cpus/cpu@N/compatible source for aarch64 that the
# kernel does not in fact print into /proc/cpuinfo.) Sourcing the arm64
# brand from the device tree is tracked in roadmap.md, not done here —
# it is a second source for one fact and needs hardware to verify.
fn mihi_cpu_model(buf, cap): cstring {
    #ifdef CYRIUS_TARGET_AGNOS
    # AGNOS has no /proc — read the brand straight from CPUID (the same x86 datum
    # /proc/cpuinfo's "model name" is printed from). Linux-validated (see tests).
    return mihi_cpu_model_cpuid(buf, cap);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var n = _mihi_read_probe_file("/proc/cpuinfo", buf, cap, MIHI_IO_PREFIX);
    if (n < 0) { return 0; }
    return mihi_parse_cpu_model(buf, n);
    #endif
}

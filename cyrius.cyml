[package]
name = "mihi"
version = "${file:VERSION}"
description = "मिही / mihi — system-info probe library (CPU / RAM / GPU / kernel / uptime / distro / hostname). Substrate for iam, chakshu, and other tools that need 'tell me about this box'. Maori: the formal self-introduction ceremony."
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.7.9"

[build]
# The in-tree smoke binary: exercises the whole probe surface end to end.
entry = "programs/smoke.cyr"
test = "src/test.cyr"
output = "build/mihi-smoke"

[lib]
# `cyrius distlib` concatenates these, in order, into dist/mihi.cyr. The order
# is load-bearing: docs/architecture/001-bundle-and-dependency-shape.md.
modules = ["src/types.cyr", "src/io.cyr", "src/cpu.cyr", "src/mem.cyr", "src/kernel.cyr", "src/host.cyr", "src/gpu.cyr"]

[deps]
# mihi's own builds: src/, programs/, tests/ (`assert`) and benches/ (`bench`).
# Consumers do not inherit it; dist/mihi.deps comes from distlib's compile-verify.
stdlib = ["syscalls", "string", "alloc", "io", "result", "vec", "sys", "sakshi", "assert", "bench"]

# Accelerator detection. mihi calls registry_detect_no_exec() only.
[deps.ai-hwaccel]
git = "https://github.com/MacCracken/ai-hwaccel.git"
tag = "2.4.2"
modules = ["dist/ai-hwaccel.cyr"]

# Optional, so consumers never resolve it (features are read from the root
# manifest only). It defines the unreachable bayan_json_v_* names that
# dist/ai-hwaccel.cyr leaves to its consumer. Never the stdlib bayan monolith:
# docs/architecture/001-bundle-and-dependency-shape.md.
[deps.bayan]
optional = true
git = "https://github.com/MacCracken/bayan.git"
tag = "1.5.14"
modules = ["dist/bayan-json.cyr"]

[features]
default = ["bayan"]

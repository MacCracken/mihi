[package]
name = "mihi"
version = "${file:VERSION}"
description = "मिही / mihi — system-info probe library (CPU / RAM / GPU / kernel / uptime / distro / hostname). Substrate for iam, chakshu, and other tools that need 'tell me about this box'. Maori: the formal self-introduction ceremony."
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.6.0"

[build]
# In-tree smoke binary — exercises the lib API end-to-end. Consumers
# bundle via `cyrius distlib` from the [lib].modules list below.
entry = "programs/smoke.cyr"
test = "src/test.cyr"
output = "build/mihi-smoke"

[lib]
# Domain modules concatenated by `cyrius distlib` into dist/mihi.cyr —
# the single-file bundle consumed via `include "lib/mihi.cyr"` after
# `cyrius deps`. Order matters: types first, then io.cyr (the shared
# /proc + /sys read path — cpu/mem/host all call into it, so it must
# precede them), then probes in dependency order. gpu.cyr is last
# because it depends on ai-hwaccel symbols that the bundle's consumer
# is expected to have already included. io.cyr joined the set at 1.2.3;
# see docs/adr/0003-shared-probe-read.md for why a sixth module beat
# duplicating the hardened read four times.
modules = ["src/types.cyr", "src/io.cyr", "src/cpu.cyr", "src/mem.cyr", "src/kernel.cyr", "src/host.cyr", "src/gpu.cyr"]

[deps]
# mihi's identity probes (kernel_name / kernel_version / cpu_arch / hostname)
# share one uname#34 + sysinfo#35 through the cyrius stdlib `sys` module
# (lib/sys.cyr — the uname/sysinfo plumbing carved off agnosys at cyrius 6.1.28,
# with per-target UTS_*/SI_* offsets for both Linux and AGNOS). Rewired off the
# old [deps.agnosys] git dep (agnosys_uname / query_sysinfo) to sys_uname /
# sys_sysinfo at 2026-06-22, after cyrius retired the stale stdlib agnosys
# snapshot at 6.2.37. docs/adr/0001-shared-uts-buffer.md.
#
# Bundle-driven additions (for ai-hwaccel 2.2.5):
#   fs, tagged, process, fnptr, thread, freelist, hashmap — referenced
#   by modules inside dist/ai-hwaccel.cyr (cache/lazy/async_detect/
#   detect/command). Even under the no-exec mask the bundle is one
#   concatenation, so the parser needs the full set; DCE drops unused
#   code from the linked binary.
#
# `bayan` was in this list through 1.2.4, purely as cover for the
# `registry_to_json` path inside dist/ai-hwaccel.cyr — mihi's own source
# references zero json/bayan symbols (verified: `grep -rE '\b(bayan|json)_' src/`
# is empty). It was never mihi's dependency.
#
# Dropped at 1.2.5: ai-hwaccel 2.3.19 moved those call sites off bayan's legacy
# back-compat aliases onto the canonical `bayan_json_v_*` names and now carries
# its own focused `bayan-json` dep, so its sidecar no longer asks consumers for
# bayan either. Declaring it here forced every mihi consumer to link the full
# 641 KB bayan monolith (json + toml + cyml + csv + base64 + bigint + u128 +
# yaml + pdf) for a JSON path mihi never touches. Do not re-add it: if a future
# mihi genuinely needs JSON, take `dist/bayan-json.cyr` as a git dep instead.
#
# 1.2.6 finished the job upstream. ai-hwaccel 2.3.20 made its own `[deps.bayan]`
# `optional = true` behind a `[features]` gate, so it no longer resolves
# TRANSITIVELY into consumers either: mihi's lock lost its second commit pin
# (bayan 1.5.2), and the orphaned `lib/bayan-json.cyr` was pruned. The visible
# residue is seven `undefined function 'bayan_json_v_*'` build warnings. They
# are EXPECTED and must not be "fixed" by adding bayan back here — all five
# enclosing functions (`_pj_int` / `_pj_bool` / `_pj_cstr` / `profile_from_json`
# / `profile_from_json_str`) have zero callers inside ai-hwaccel, so the symbols
# are unreachable and DCE eliminates them. ai-hwaccel 2.3.20 names mihi as one
# of three consumers in exactly this position.
stdlib = ["string", "fmt", "alloc", "io", "vec", "str", "slice", "syscalls", "sys", "assert", "fs", "tagged", "process", "fnptr", "thread", "freelist", "hashmap", "sakshi", "ct", "bench"]

# ai-hwaccel: hardware-accelerator detection. 2.2.5 was the first release
# with the no-exec contract (registry_detect_no_exec() + builder_no_exec());
# mihi M3 GPU probes call exclusively into that API — never registry_detect()
# — because probes are pure reads. See docs/development/roadmap.md.
#
# Pin history: 2.2.5 (0.4.0) -> 2.2.6 (0.4.1) -> 2.3.18 (1.2.2) -> 2.3.19
# (1.2.5, forced: it is what moves the bundle onto canonical bayan_json_v_*
# names) -> 2.3.22 (1.2.6). Nothing in 2.3.20/21/22 changes a symbol mihi
# calls; 2.3.21 is ai-hwaccel's own cyrius 6.6.0 bump, which is why this pin
# and [package].cyrius move together.
[deps.ai-hwaccel]
git = "https://github.com/MacCracken/ai-hwaccel.git"
tag = "2.3.22"
modules = ["dist/ai-hwaccel.cyr"]
